        "jsCode": "const today = new Date();\nconst year = today.getFullYear();\nconst month = String(today.getMonth() + 1).padStart(2, '0');\nconst day = String(today.getDate()).padStart(2, '0');\nconst todayStr = year + '-' + month + '-' + day;\n\nconst items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  let pubDate = item.json.pubDate || '';\n  \n  // 格式1: 36kr \"2026-04-08 08:17:41  +0800\"\n  const dateMatch1 = pubDate.match(/^(\\d{4}-\\d{2}-\\d{2})/);\n  if (dateMatch1) {\n    pubDate = dateMatch1[1];\n  }\n  \n  // 格式2: RFC 1123 \"Wed, 08 Apr 2026 07:20:00 +0800\" 或 \"Tue, 07 Apr 2026 14:53:00 GMT\"\n  const dateMatch2 = pubDate.match(/(\\d{2})\\s+\\w+\\s+(\\d{4})/);\n  if (dateMatch2) {\n    const d = dateMatch2[1];\n    const mNames = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];\n    const mStr = pubDate.split(' ')[2];\n    const m = String(mNames.indexOf(mStr) + 1).padStart(2, '0');\n    const y = dateMatch2[2];\n    pubDate = y + '-' + m + '-' + d;\n  }\n  \n  // 只保留今天的文章，且 pubDate 转为 YYYY-MM-DD 格式\n  if (pubDate === todayStr) {\n    results.push({\n      json: {\n        ...item.json,\n        pubDate: pubDate\n      }\n    });\n  }\n}\n\nreturn results;\n"
