      "parameters": {
        "jsCode": "const firstItem = $input.first();\n\nif (firstItem.json.title || firstItem.json.link) {\n  return $input.all();\n}\n\nconst binaryProp = firstItem.binary;\nlet rawBuffer;\nlet text = '';\n\nif (binaryProp && binaryProp.data) {\n  rawBuffer = Buffer.from(binaryProp.data);\n  const sample = rawBuffer.toString('ascii', 0, 300);\n  let encoding = 'utf-8';\n  const encMatch = sample.match(/charset=[\"']?([^\"'>]+)/i);\n  if (encMatch && /gbk|gb2312|gb18030/i.test(encMatch[1])) encoding = 'gbk';\n  text = rawBuffer.toString(encoding);\n} else {\n  text = firstItem.json.data || firstItem.json.output || '';\n}\n\nconst sourceName = $('遍历抓取源').first().json.name || 'Unknown';\nconst articles = [];\n\n// ---- jdqs.net / 家电圈 ----\nconst liMatches = text.match(/<li class=\"wutu\"[\\s\\S]*?<\\/li>/gi);\nif (liMatches) {\n  liMatches.forEach(li => {\n    const linkM = li.match(/href=\"([^\"]+)\"/);\n    const titleM = li.match(/title=\"([^\"]+)\"/);\n    const timeM = li.match(/<span class=\"time\"[^>]*>([\\d\\- :]+)<\\/span>/);\n    if (linkM && titleM) {\n      articles.push({\n        title: titleM[1].replace(/<[^>]+>/g, '').trim(),\n        link: linkM[1],\n        guid: linkM[1],\n        pubDate: timeM ? timeM[1].trim().substring(0, 10) : '',\n        source: sourceName\n      });\n    }\n  });\n}\n\n// ---- cheaa.com / 新闻频道 ----\nconst cheaaMatches = text.match(/<p class=\"pctit\"[\\s\\S]*?<\\/p>/gi);\nif (cheaaMatches) {\n  cheaaMatches.forEach(p => {\n    const linkM = p.match(/href=\"(https:\\/\\/[^\\\"]+\\.cheaa\\.com\\/[^?'\"]+\\.shtml)\"/);\n    const titleM = p.match(/title=\"([^\"]+)\"/);\n    if (linkM && titleM) {\n      articles.push({\n        title: titleM[1].replace(/<[^>]+>/g, '').trim(),\n        link: linkM[1],\n        guid: linkM[1],\n        pubDate: '',\n        source: sourceName\n      });\n    }\n  });\n}\n\n// ---- icebox/washer/kitchen.cheaa.com 子站 ----\nconst newsInMatches = text.match(/<div class=\"newsIn\"[\\s\\S]*?<\\/div>\\s*<\\/div>/gi);\nif (newsInMatches) {\n  newsInMatches.forEach(block => {\n    const linkM = block.match(/href=\"(https:\\/\\/[^\\\"]+\\.cheaa\\.com\\/[^?'\"]+\\.shtml)\"/);\n    const titleM = block.match(/title=\"([^\"]+)\"/);\n    if (linkM && titleM) {\n      articles.push({\n        title: titleM[1].replace(/<[^>]+>/g, '').trim(),\n        link: linkM[1],\n        guid: linkM[1],\n        pubDate: '',\n        source: sourceName\n      });\n    }\n  });\n}\n\n// ---- donews.com / DoNews家电 ----\nconst donewsMatches = text.match(/<div class=\"normal-item\"[\\s\\S]*?class=\"news-info\"[^>]*>([\\s\\S]*?)<\\/div>\\s*<\\/div>/gi);\nif (donewsMatches) {\n  donewsMatches.forEach(item => {\n    const linkM = item.match(/href=\"(https:\\/\\/www\\.donews\\.com\\/news\\/detail\\/[^\"]+)\"/);\n    const titleM = item.match(/<span class=\"title\"[^>]*>[\\s\\S]*?<a[^>]*>([^<]+)<\\/a>/);\n    const dateM = item.match(/(\\d{4}-\\d{2}-\\d{2})/);\n    if (linkM && titleM) {\n      articles.push({\n        title: titleM[1].replace(/<[^>]+>/g, '').trim(),\n        link: linkM[1],\n        guid: linkM[1],\n        pubDate: dateM ? dateM[1] : '',\n        source: 'DoNews家电'\n      });\n    }\n  });\n}\n\n// ---- abi.com.cn / 艾肯家电网 ----\nconst abiMatches = text.match(/<li><div class=\"text\">[\\s\\S]*?<\\/div>\\s*<\\/li>/gi);\nif (abiMatches) {\n  abiMatches.forEach(item => {\n    const linkM = item.match(/href=\"(http:\\/\\/www\\.abi\\.com\\.cn\\/news\\/htmfiles\\/[^\"]+)\"/);\n    const titleM = item.match(/<h5><a[^>]+title=\"([^\"]+)\"/);\n    const timeM = item.match(/<span class=\"time\"[^>]*>[\\s\\S]*?(\\d{4}-\\d{1,2}-\\d{1,2})/);\n    if (linkM && titleM) {\n      articles.push({\n        title: titleM[1].replace(/<[^>]+>/g, '').trim(),\n        link: linkM[1],\n        guid: linkM[1],\n        pubDate: timeM ? timeM[1] : '',\n        source: '艾肯家电网'\n      });\n    }\n  });\n}\n\n// ---- huanqiu.com / 环球网 - 家电家居 ----\nconst huanqiuBlock = text.match(/<div class=\"csr_sketch_mix_2\">[\\s\\S]*?<\\/div>\\s*<\\/div>/i);\nif (huanqiuBlock) {\n  const parts = huanqiuBlock[0].split(/<div class=\"item\">/).slice(1);\n  parts.forEach(part => {\n    const aidM = part.match(/<textarea class=\"item-aid\"[^>]*>([^<]+)<\\/textarea>/);\n    const titleM = part.match(/<textarea class=\"item-title\"[^>]*>([^<]+)<\\/textarea>/);\n    const timeM = part.match(/<textarea class=\"item-time\"[^>]*>([^<]+)<\\/textarea>/);\n    if (aidM && titleM) {\n      const link = 'https://tech.huanqiu.com/article/' + aidM[1];\n      const ts = timeM ? parseInt(timeM[1]) : 0;\n      const date = ts > 0 ? new Date(ts).toISOString().substring(0, 10) : '';\n      articles.push({\n        title: titleM[1].trim(),\n        link: link,\n        guid: link,\n        pubDate: date,\n        source: '环球网'\n      });\n    }\n  });\n}\n\nconst seen = new Set();\nconst unique = articles.filter(a => { if (seen.has(a.guid)) return false; seen.add(a.guid); return true; });\nreturn unique.slice(0, 30).map(a => ({ json: a }));\n"
