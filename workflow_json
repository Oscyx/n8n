      "parameters": {
        "jsCode": "const httpData = $input.first().json;\nconst item = $('遍历抓取文章').first().json;\n\nconst html = httpData.data || '';\n\nlet text = '';\n\n// 判断是否是环球网文章页\nconst contentMatch = html.match(/<textarea class=\"article-content\"[^>]*>([\\s\\S]*?)<\\/textarea>/i);\nif (contentMatch) {\n  // 环球网格式\n  text = contentMatch[1];\n  text = text.replace(/<\\/?article[^>]*>/gi, '');\n  text = text.replace(/<section[^>]*>/gi, '');\n  text = text.replace(/<\\/section>/gi, '');\n  text = text.replace(/<p[^>]*>/gi, '\\n');\n  text = text.replace(/<br\\s*\\/?>/gi, '\\n');\n  text = text.replace(/<i class=\"pic-con\"[^>]*>[\\s\\S]*?<\\/i>/gi, '');\n  text = text.replace(/<adv-loader[^>]*>[\\s\\S]*?<\\/adv-loader>/gi, '');\n} else {\n  // donews 格式（原有逻辑）\n  const ctrlStart = html.indexOf('id=\"ctrlfscont\"');\n  const shareStart = html.indexOf('id=\"share-2\"');\n  if (ctrlStart > 0 && shareStart > 0) {\n    text = html.substring(ctrlStart, shareStart);\n  } else {\n    // jdqs 家电圈格式\n    const newscontStart = html.indexOf('id=\"newscont\"');\n    if (newscontStart > 0) {\n      const newscontEnd = html.indexOf('</div>', newscontStart);\n      if (newscontEnd > 0) {\n        text = html.substring(newscontStart, newscontEnd);\n      }\n    }\n  }\n  text = text.replace(/<[^>]+>/g, '');\n  text = text.replace(/id=\"[^\"]*\"/g, '');\n  text = text.replace(/class=\"[^\"]*\"/g, '');\n}\n\n// HTML 实体清理\ntext = text.replace(/&nbsp;/g, ' ');\ntext = text.replace(/&ldquo;/g, '\"').replace(/&rdquo;/g, '\"');\ntext = text.replace(/&amp;/g, '&');\ntext = text.replace(/&lsquo;/g, \"'\").replace(/&rsquo;/g, \"'\");\n\n// 去除 HTML 残留\ntext = text.replace(/<div[\"\\s\\S]*$/, '');\n\n// 去除全角空格和多余空白\ntext = text.replace(/　+/g, ' ');\ntext = text.replace(/\\s+/g, ' ');\n\n// 智能分段：句号换行\ntext = text.replace(/。/g, '。\\n');\ntext = text.replace(/\\n\\s*/g, '\\n');\ntext = text.trim();\n\n// 截取前5000字符\ntext = text.substring(0, 5000);\n\nreturn {\n  json: {\n    title: item.title || '',\n    link: item.link || '',\n    pubDate: item.pubDate || '',\n    content: text\n  }\n};\n"
