        "jsCode": "const keywords = ['海尔', '卡萨帝', '统帅', '美的', '小天鹅', 'COLMO', '东芝', '海信', '容声', '小米', '华为', '追觅', '石头', '西门子', '博世', '松下', '三星', 'LG', '洗衣机', '烘干机', '洗碗机', '洗烘套装', '冰箱', '全屋智能', '具身智能', '人车家全生态', '扫地机器人', '黑电', '白电', '烤箱', '华帝'];\n\nconst items = $input.all();\nconst result = items.filter(item => {\n  const text = (item.json.title + ' ' + (item.json.content || '') + ' ' + (item.json.summary || ''));\n  return keywords.some(kw => text.includes(kw));\n});\nreturn result;\n"
