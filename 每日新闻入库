    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\n// 第一步：按 link 去重\nconst linkSeen = new Set();\nconst byLink = items.filter(item => {\n  const link = item.json.link || '';\n  if (linkSeen.has(link)) {\n    return false;\n  }\n  linkSeen.add(link);\n  return true;\n});\n\n// 第二步：按 title 去重\nconst titleSeen = new Set();\nconst result = byLink.filter(item => {\n  const title = item.json.title || item.json.标题 || '';\n  if (titleSeen.has(title)) {\n    return false;\n  }\n  titleSeen.add(title);\n  return true;\n});\n\nreturn result;\n"
      },
