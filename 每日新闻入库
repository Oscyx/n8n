    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst highPriorityKeywords = [\n  '冰箱',\n  '洗衣机',\n  '干衣机',\n  '烘干机',\n  '洗烘一体机',\n  '洗烘塔',\n  '大家电',\n  '白电'\n];\n\nconst mediumPriorityKeywords = [\n  '洗碗机',\n  '厨电',\n  '扫地机器人',\n  '家电'\n];\n\nconst lowPriorityKeywords = [\n  '具身智能',\n  '白皮书',\n  '行业热点'\n];\n\nconst allKeywords = [\n  ...highPriorityKeywords,\n  ...mediumPriorityKeywords,\n  ...lowPriorityKeywords\n];\n\nreturn items\n  .filter(item => {\n    const title = item.json['标题'] || '';\n    return allKeywords.some(keyword => title.includes(keyword));\n  })\n  .map(item => {\n    const title = item.json['标题'] || '';\n\n    let priority = '低';\n    let industry = '';\n\n    const matchedHigh = highPriorityKeywords.find(keyword => title.includes(keyword));\n    const matchedMedium = mediumPriorityKeywords.find(keyword => title.includes(keyword));\n    const matchedLow = lowPriorityKeywords.find(keyword => title.includes(keyword));\n\n    if (matchedHigh) {\n      priority = '高';\n      industry = matchedHigh;\n    } else if (matchedMedium) {\n      priority = '中';\n      industry = matchedMedium;\n    } else if (matchedLow) {\n      priority = '低';\n      industry = matchedLow;\n    }\n\n    return {\n      json: {\n        标题: item.json['标题'] || '',\n        链接: item.json['链接'] || '',\n        发布日期: item.json['发布日期'] || '',\n        摘要: `奥维云网${industry}文章，点击链接查看原文。`,\n        重要性: priority\n      }\n    };\n  });\n"
      },
