        "jsCode": "const today = new Date();\nconst year = today.getFullYear();\nconst month = String(today.getMonth() + 1).padStart(2, '0');\nconst day = String(today.getDate()).padStart(2, '0');\nconst todayStr = year + '-' + month + '-' + day;\nconst items = $input.all();\nconst results = [];\nfor (const item of items) {\n  let pubDate = item.json.pubDate || '';\n  const dateMatch1 = pubDate.match(/^(\\d{4}-\\d{2}-\\d{2})/);\n  if (dateMatch1) pubDate = dateMatch1[1];\n  const dateMatch2 = pubDate.match(/(\\d{2})\\s+\\w+\\s+(\\d{4})/);\n  if (dateMatch2) {\n    const d = dateMatch2[1];\n    const mNames = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];\n    const mStr = pubDate.split(' ')[2];\n    const m = String(mNames.indexOf(mStr) + 1).padStart(2, '0');\n    const y = dateMatch2[2];\n    pubDate = y + '-' + m + '-' + d;\n  }\n  if (pubDate === todayStr) {\n    results.push({ json: { ...item.json, pubDate, poolDate: todayStr, sourceType: 'rss' } });\n  }\n}\nreturn results;"
