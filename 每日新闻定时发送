    {
      "parameters": {
        "jsCode": "const httpData = $input.first().json;\nconst item = $('遍历抓取文章').first().json;\n\nconst html = httpData.data || '';\n\nlet text = '';\n\n// ========== abi.com.cn 艾肯家电网 ==========\nif (html.includes('abi.com.cn') || html.includes('cr_h1title')) {\n  const titleM = html.match(/<h1 class=\"cr_h1title\">([^<]+)<\\/h1>/);\n  const timeMatch = html.match(/<div class=\"am-cf author-panel\"[\\s\\S]*?<abbr class=\"time\">(\\d{4}-\\d{1,2}-\\d{1,2})/);\n  const authorMatch = html.match(/<div class=\"am-cf author-panel\"[\\s\\S]*?<abbr class=\"time\">\\d{4}-\\d{1,2}-\\d{1,2}<\\/abbr>[\\s\\S]*?<abbr class=\"time\">([^<]+)<\\/abbr>/);\n  \n  const contentMatch = html.match(/<section class=\"textblock\">([\\s\\S]*?)<\\/section>/);\n  if (contentMatch) {\n    const ps = contentMatch[1].match(/<p[^>]*>([\\s\\S]*?)<\\/p>/gi);\n    if (ps) {\n      text = ps.map(p => p.replace(/<[^>]+>/g, '').replace(/&nbsp;/g, ' ').trim()).filter(t => t).join('\\n');\n    } else {\n      text = contentMatch[1].replace(/<[^>]+>/g, '').replace(/&nbsp;/g, ' ').trim();\n    }\n  }\n  \n  return {\n    json: {\n      title: item.title || (titleM ? titleM[1].trim() : ''),\n      link: item.link || '',\n      pubDate: item.pubDate || (timeMatch ? timeMatch[1] : ''),\n      author: authorMatch ? authorMatch[1].trim() : '艾肯家电网',\n      content: text || item.摘要 || ''\n    }\n  };\n}\n\n// ========== zdwang.com 智电网 ==========\nif (html.includes('zdwang.com') || html.includes('class=\"biaoti\"')) {\n  const titleM = html.match(/<h1>([^<]+)<\\/h1>/);\n  const timeMatch = html.match(/发布时间：(\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2})/);\n  \n  const contentMatch = html.match(/<div class=\"content\">([\\s\\S]*?)<\\/div>\\s*<div class=\"ep-source\">/);\n  text = '';\n  if (contentMatch) {\n    const ps = contentMatch[1].match(/<p[^>]*>([\\s\\S]*?)<\\/p>/gi);\n    if (ps) {\n      text = ps.map(p => p.replace(/<[^>]+>/g, '').replace(/&nbsp;/g, ' ').trim()).filter(t => t).join('\\n');\n    }\n  }\n  \n  let dateStr = '';\n  if (timeMatch) {\n    const dt = new Date(timeMatch[1]);\n    dateStr = dt.toISOString().substring(0, 10);\n  }\n  \n  return {\n    json: {\n      title: item.title || (titleM ? titleM[1].trim() : ''),\n      link: item.link || '',\n      pubDate: item.pubDate || dateStr,\n      content: text || item.摘要 || ''\n    }\n  };\n}\n// ---- ichaoqi.com / 潮起网 - 文章详情页 ----\nif (html.includes('ichaoqi.com') || html.includes('entry-title')) {\n  const titleM = html.match(/<h1 class=\"entry-title[^\"]*\"[^>]*>([^<]+)<\\/h1>/);\n  const canonicalM = html.match(/<link rel=\"canonical\" href=\"([^\"]+)\"/);\n  const dateM = html.match(/<meta property=\"article:published_time\" content=\"([^\"]+)\"/);\n  \n  const contentMatch = html.match(/<div class=\"entry-content[^\"]*\"[^>]*>([\\s\\S]*?)<\\/div>\\s*<footer/);\n  text = '';\n  if (contentMatch) {\n    const ps = contentMatch[1].match(/<p[^>]*>([\\s\\S]*?)<\\/p>/gi);\n    if (ps) {\n      text = ps.map(p => p.replace(/<[^>]+>/g, '').replace(/&nbsp;/g, ' ').trim()).filter(t => t).join('\\n');\n    } else {\n      text = contentMatch[1].replace(/<[^>]+>/g, '').replace(/&nbsp;/g, ' ').trim();\n    }\n  }\n  \n  return {\n    json: {\n      title: item.title || (titleM ? titleM[1].trim() : ''),\n      link: item.link || (canonicalM ? canonicalM[1] : ''),\n      pubDate: item.pubDate || (dateM ? dateM[1].substring(0, 10) : ''),\n      content: text || item.摘要 || ''\n    }\n  };\n}\n// ========== 环球网 ==========\nconst hqContent = html.match(/<textarea class=\"article-content\"[^>]*>([\\s\\S]*?)<\\/textarea>/i);\nif (hqContent) {\n  text = hqContent[1];\n  text = text.replace(/<\\/?article[^>]*>/gi, '');\n  text = text.replace(/<section[^>]*>/gi, '');\n  text = text.replace(/<\\/section>/gi, '');\n  text = text.replace(/<p[^>]*>/gi, '\\n');\n  text = text.replace(/<br\\s*\\/?>/gi, '\\n');\n  text = text.replace(/<i class=\"pic-con\"[^>]*>[\\s\\S]*?<\\/i>/gi, '');\n  text = text.replace(/<adv-loader[^>]*>[\\s\\S]*?<\\/adv-loader>/gi, '');\n} else {\n  // donews 格式\n  const ctrlStart = html.indexOf('id=\"ctrlfscont\"');\n  const shareStart = html.indexOf('id=\"share-2\"');\n  if (ctrlStart > 0 && shareStart > 0) {\n    text = html.substring(ctrlStart, shareStart);\n  } else {\n    // jdqs 家电圈格式\n    const newscontStart = html.indexOf('id=\"newscont\"');\n    if (newscontStart > 0) {\n      const newscontEnd = html.indexOf('</div>', newscontStart);\n      if (newscontEnd > 0) {\n        text = html.substring(newscontStart, newscontEnd);\n      }\n    }\n  }\n  text = text.replace(/<[^>]+>/g, '');\n  text = text.replace(/id=\"[^\"]*\"/g, '');\n  text = text.replace(/class=\"[^\"]*\"/g, '');\n}\n\n// HTML 实体清理\ntext = text.replace(/&nbsp;/g, ' ');\ntext = text.replace(/&ldquo;/g, '\"').replace(/&rdquo;/g, '\"');\ntext = text.replace(/&amp;/g, '&');\ntext = text.replace(/&lsquo;/g, \"'\").replace(/&rsquo;/g, \"'\");\n\n// 去除 HTML 残留\ntext = text.replace(/<div[\"\\s\\S]*$/, '');\n\n// 去除全角空格和多余空白\ntext = text.replace(/　+/g, ' ');\ntext = text.replace(/\\s+/g, ' ');\n\n// 智能分段：句号换行\ntext = text.replace(/。/g, '。\\n');\ntext = text.replace(/\\n\\s*/g, '\\n');\ntext = text.trim();\n\n// 截取前20000字符\ntext = text.substring(0, 20000);\n\nreturn {\n  json: {\n    title: item.title || '',\n    link: item.link || '',\n    pubDate: item.pubDate || '',\n    content: text || item.摘要 || ''\n  }\n};\n"
      },
