        "jsCode": "const priorityOrder = {\n  '高': 0,\n  '中': 1,\n  '低': 2,\n};\n\nconst items = $input\n  .all()\n  .filter(item => {\n    const j = item.json || {};\n    return j.标题 && j.链接;\n  })\n  .map(item => {\n    const j = { ...item.json };\n\n    if (Array.isArray(j.其他相关链接) && j.其他相关链接.length === 0) {\n      delete j.其他相关链接;\n    }\n\n    return { json: j };\n  })\n  .sort((a, b) => {\n    const pa = priorityOrder[a.json.重要性] ?? 99;\n    const pb = priorityOrder[b.json.重要性] ?? 99;\n\n    if (pa !== pb) return pa - pb;\n\n    const da = a.json.发布日期 || '';\n    const db = b.json.发布日期 || '';\n    return db.localeCompare(da);\n  });\n\nreturn items;\n"
      },
