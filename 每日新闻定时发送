      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\n\nfunction normalizeBadJson(raw) {\n  if (typeof raw !== 'string') return raw;\n\n  let s = raw.trim();\n\n  // 去掉代码块包裹\n  s = s.replace(/^```(?:json)?\\s*/i, '').replace(/\\s*```$/, '');\n\n  // 中文引号转英文\n  s = s\n    .replace(/[\\u201C\\u201D]/g, '\"')\n    .replace(/[\\u2018\\u2019]/g, \"'\");\n\n  // 删除不该出现在这个节点里的字段：其他相关链接\n  s = s.replace(/,\\s*\"其他相关链接\"\\s*:\\s*(\\[[^\\]]*\\]|\\{[^}]*\\}|null|\"\"|\"[^\"]*\"|[^,}\\]]*)/g, '');\n\n  // 修复尾逗号\n  s = s.replace(/,\\s*}/g, '}').replace(/,\\s*]/g, ']');\n\n  return s;\n}\n\nfunction tryParse(raw) {\n  if (!raw) return null;\n  if (typeof raw === 'object') return raw;\n\n  let s = normalizeBadJson(raw);\n\n  try {\n    return JSON.parse(s);\n  } catch (e1) {\n    // 修复字符串值内部未转义的英文引号，重点处理标题/摘要\n    try {\n      s = s.replace(/\"标题\"\\s*:\\s*\"([\\s\\S]*?)\"(?=\\s*,\\s*\"链接\")/g, (_, v) => {\n        return `\"标题\":\"${v.replace(/\"/g, '\\\\\"')}\"`;\n      });\n\n      s = s.replace(/\"摘要\"\\s*:\\s*\"([\\s\\S]*?)\"(?=\\s*,\\s*\"重要性\")/g, (_, v) => {\n        return `\"摘要\":\"${v.replace(/\"/g, '\\\\\"')}\"`;\n      });\n\n      s = s.replace(/\"链接\"\\s*:\\s*\"([\\s\\S]*?)\"(?=\\s*,\\s*\"发布日期\")/g, (_, v) => {\n        return `\"链接\":\"${v.replace(/\"/g, '\\\\\"')}\"`;\n      });\n\n      s = s.replace(/\"发布日期\"\\s*:\\s*\"([\\s\\S]*?)\"(?=\\s*,\\s*\"摘要\")/g, (_, v) => {\n        return `\"发布日期\":\"${v.replace(/\"/g, '\\\\\"')}\"`;\n      });\n\n      return JSON.parse(s);\n    } catch (e2) {\n      return null;\n    }\n  }\n}\n\nfor (const item of items) {\n  const raw = item.json.output || item.json.text || '';\n  const output = tryParse(raw);\n\n  if (!output) {\n    continue;\n  }\n\n  results.push({\n    json: { output }\n  });\n}\n\nreturn results;"
